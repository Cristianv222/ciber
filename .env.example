# Base de Datos PostgreSQL
POSTGRES_DB=netflows
POSTGRES_USER=tesis
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (Channel Layer / Mensajería WebSockets)
REDIS_HOST=redis

# Panel de Visualización Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Backend Django
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
ALLOWED_HOSTS=*

# Servidor XMPP ejabberd (mensajería entre agentes SPADE)
# Dominio XMPP = "ejabberd". JIDs: detector@ejabberd, decision@ejabberd, response@ejabberd
XMPP_ADMIN_PASSWORD=
XMPP_DETECTOR_PASSWORD=
XMPP_DECISION_PASSWORD=
XMPP_RESPONSE_PASSWORD=

# Ingesta / CICFlowMeter (Capa 2)
CAPTURE_MODE=live            # live (interfaz) | pcap (archivo)
SPAN_INTERFACE=eth0          # interfaz del puerto SPAN en la máquina de la U
PCAP_FILE=                   # ruta al .pcap para modo pcap (p. ej. /data/pcap/muestra.pcap)
INGEST_MODE=api              # api (POST /api/flows/, dispara WebSocket) | db (INSERT directo)
API_BASE_URL=http://localhost:8000
INGEST_DB_HOST=localhost     # host de Postgres para la ingesta (localhost por network_mode host)
FLOW_TIMEOUT=120             # segundos para cerrar un flujo inactivo
ACTIVITY_TIMEOUT=5           # segundos que separan ráfagas activas de periodos idle

# Entrenamiento de modelos ML (Fase 2)
DATASET_PATH=/data/datasets  # carpeta de CSV CIC-IDS dentro del contenedor
TRAIN_TEST_SIZE=0.2
TRAIN_EPOCHS=15
TRAIN_BATCH_SIZE=256
TRAIN_AE_PERCENTILE=99       # percentil del error benigno para el umbral del autoencoder

# Agente detector (Fase 3)
DETECTOR_JID=detector@ejabberd
DECISION_JID=decision@ejabberd
DETECTOR_POLL_INTERVAL=5     # segundos entre sondeos de flujos sin clasificar
DETECTOR_BATCH_SIZE=100      # flujos por sondeo
XGB_ATTACK_THRESHOLD=0.6     # confianza mín. para marcar ataque (etapa XGBoost)
XGB_BENIGN_THRESHOLD=0.8     # confianza mín. para cerrar como benigno (etapa XGBoost)
CNN_THRESHOLD=0.5            # prob. mín. de ataque (etapa CNN-LSTM)

# Agente de decisión (Fase 4)
RESPONSE_JID=response@ejabberd
CVSS_BLOCK_THRESHOLD=7.0     # CVSS v4.0 mínimo para ordenar bloqueo (7.0 = High)

# Agente de respuesta (Fase 5)
RESPONSE_DRY_RUN=true        # true = simula el bloqueo (local); false = ejecuta iptables (U)

# XMPP: true = texto plano (recomendado en Apple Silicon; el NIF TLS falla bajo emulación)
XMPP_DISABLE_TLS=true
