# =============================================================================
# Plantilla de entorno de PRODUCCIÓN (máquina de la universidad)
# Copia a .env.prod y rellena con valores seguros. NO lo subas a git.
# =============================================================================

# --- Base de Datos PostgreSQL ---
POSTGRES_DB=netflows
POSTGRES_USER=tesis
POSTGRES_PASSWORD=            # contraseña fuerte y única
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=       # contraseña fuerte

# --- Backend Django (ENDURECIDO) ---
DJANGO_SECRET_KEY=           # cadena aleatoria larga (p. ej. `openssl rand -base64 48`)
DJANGO_DEBUG=False
ALLOWED_HOSTS=monitor.uni.edu,10.0.0.10          # hosts/IptR reales, separados por coma
CORS_ALLOWED_ORIGINS=https://monitor.uni.edu     # orígenes del frontend, sin comodines
CSRF_TRUSTED_ORIGINS=https://monitor.uni.edu     # para el admin sobre HTTPS

# --- XMPP ejabberd (mensajería entre agentes) ---
XMPP_ADMIN_PASSWORD=
XMPP_DETECTOR_PASSWORD=
XMPP_DECISION_PASSWORD=
XMPP_RESPONSE_PASSWORD=

# --- Ingesta / CICFlowMeter ---
CAPTURE_MODE=live
SPAN_INTERFACE=eth1          # interfaz conectada al puerto SPAN
INGEST_MODE=api              # api (WebSocket en vivo) | db (mayor rendimiento)

# --- Entrenamiento (a demanda) ---
DATASET_PATH=/data/datasets
TRAIN_EPOCHS=25
TRAIN_BATCH_SIZE=512
TRAIN_AE_PERCENTILE=99

# --- Agente detector ---
DETECTOR_POLL_INTERVAL=5
DETECTOR_BATCH_SIZE=200
XGB_ATTACK_THRESHOLD=0.6
XGB_BENIGN_THRESHOLD=0.8
CNN_THRESHOLD=0.5

# --- Agente de decisión ---
CVSS_BLOCK_THRESHOLD=7.0

# --- Agente de respuesta (BLOQUEO REAL en producción) ---
RESPONSE_DRY_RUN=false
